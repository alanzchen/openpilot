# Trusted sync configuration — lives on the default branch only; workflow inputs cannot override production values.
UPSTREAM_URL=https://github.com/firestar5683/StarPilot.git
UPSTREAM_BRANCH=StarPilot
PATCH_BRANCH=mazda-starpilot-ti
CANDIDATE_BRANCH=sync/starpilot-upstream
ANCHOR_BRANCH=sync/state/upstream-anchor
STATUS_CONTEXT=mac-trusted-build
# Rehearsal mode: every ref lives under mac-ci/rehearsal/<name>/ in this fork.
REHEARSAL_PREFIX=mac-ci/rehearsal/
# Never written by the sync job.
PROTECTED_BRANCHES="mazda-frogpilot-dev mazda-starpilot mazda-starpilot-ti master main StarPilot"
